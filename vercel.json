{
  "redirects": [
    {
      "source": "/rapidMapping",
      "destination": "/product",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://sentineltech.eu/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "site.sentineltech.eu"
        }
      ]
    },
    {
      "source": "/:path*",
      "destination": "https://sentineltech.eu/:path*",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "www.sentineltech.eu"
        }
      ]
    }
  ]
}
